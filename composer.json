{
  "name": "analytica/tenancy-core",
  "description": "Shared Laravel tenancy core package for the Analytica ecosystem",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Analytica",
      "email": "dev@analytica.ph"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "spatie/laravel-multitenancy": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Analytica\\TenancyCore\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Analytica\\TenancyCore\\TenancyCoreServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
